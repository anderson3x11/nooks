{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "nooks-api",
    "Audience": "nooks-client",
    "ExpirationDays": 7
  },
  "Moderation": {
    "AutoApprove": true
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "Nooks/0.1 (https://github.com/local/nooks)",
    "CacheHours": 24,
    "MaxResults": 5
  },
  "PhotoStorage": {
    "MaxSizeInBytes": 5242880,
    "MaxDimension": 1600,
    "ThumbnailDimension": 400,
    "Quality": 80
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
