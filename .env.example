# Copier en .env a cote de docker-compose.prod.yml, puis remplir.
# Ce fichier d'exemple est versionne, le .env ne doit jamais l'etre.

POSTGRES_DB=nooks
POSTGRES_USER=nooks
POSTGRES_PASSWORD=

# 32 caracteres minimum. Generer par exemple avec :
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=nooks-api
JWT_AUDIENCE=nooks-client

# Sur un site ouvert au public, laisser false : chaque lieu passe par la moderation.
MODERATION_AUTO_APPROVE=false

# Nominatim exige un User-Agent identifiable avec un moyen de contact.
NOMINATIM_USER_AGENT=Nooks/1.0 (contact@example.com)

# Port expose par nginx sur la machine hote.
HTTP_PORT=8080
